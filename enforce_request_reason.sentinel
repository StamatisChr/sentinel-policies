import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Setup
change_id = tfplan.variables["CHANGE_ID"].value else "MISSING"
run_id    = tfrun.id
expected  = run_id + " " + change_id

print("DEBUG: Target Value: '" + expected + "'")

# 2. Filter for the specific environment variable
# This avoids the loop issues caused by other sensitive variables
request_reason_vars = filter tfrun.variables as _, v {
    v.key is "CLOUDSDK_CORE_REQUEST_REASON" and v.category is "env"
}

# 3. Validation Logic
validate_env = func() {
    # Check if we found the variable at all
    if length(request_reason_vars) == 0 {
        print("FOUT: CLOUDSDK_CORE_REQUEST_REASON not found in Workspace.")
        return false
    }

    # Grab the first match (there should only be one)
    # We use 'val' to avoid the 'undefined' trap
    actual_var = request_reason_vars[0]
    actual_val = actual_var.value else "UNDEFINED"

    if actual_val == "UNDEFINED" {
        print("FOUT: Unable to read value. Ensure it is not sensitive.")
        return false
    }

    if actual_val != expected {
        print("FOUT: Mismatch!")
        print("  Verwacht: " + expected)
        print("  Gekregen: " + actual_val)
        return false
    }

    print("SUCCES: De waarde is correct!")
    return true
}

main = rule {
    validate_env()
}
