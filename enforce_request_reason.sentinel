import "tfplan/v2" as tfplan

# 1. Validation Logic
validate_configuration = func() {
    
    # Check if CHANGE_ID is provided and not empty
    change_id = tfplan.variables.CHANGE_ID.value else ""
    if change_id == "" {
        print("FOUT: The variable 'CHANGE_ID' is empty or missing.")
        return false
    }

    # Target string to look for in the provider block
    expected_value = "${TFE_RUN_ID} ${var.CHANGE_ID}"
    
    found_provider = false
    valid_request_reason = false

    # Iterate through provider configurations
    # We check both 'google' and 'google-beta'
    for tfplan.configuration.providers as _, p {
        if p.name == "google" or p.name == "google-beta" {
            found_provider = true
            
            # Check if request_reason attribute exists
            # We use 'is defined' to prevent 'undefined' crashes
            if (p.expressions.request_reason) is defined {
                actual_value = p.expressions.request_reason.constant_value else ""
                
                if actual_value == expected_value {
                    valid_request_reason = true
                } else {
                    print("FOUT: The 'request_reason' in provider '" + p.name + "' is incorrect.")
                    print("Verwacht: " + expected_value)
                    print("Gekregen: " + actual_value)
                }
            } else {
                print("FOUT: The 'request_reason' attribute is missing from the '" + p.name + "' provider block.")
            }
        }
    }

    if not found_provider {
        print("FOUT: No Google provider found in the configuration.")
        return false
    }

    return valid_request_reason
}

# 2. Main Rule
main = rule {
    validate_configuration()
}
