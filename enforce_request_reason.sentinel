import "tfconfig/v2" as tfconfig
import "tfrun"

print("---- Sentinel Debug Output ----")

# -------------------------
# CHANGE_ID exists in config
# -------------------------
change_id_exists = "CHANGE_ID" in tfconfig.variables
print("CHANGE_ID exists in config:", change_id_exists)

# -------------------------
# Runtime value (SAFE EXTRACTION)
# -------------------------
tfrun_change_id = ""

if "CHANGE_ID" in tfrun.variables {

  raw = tfrun.variables["CHANGE_ID"]

  # If it's a map/object with value field
  if type(raw) is "map" and "value" in raw {
    tfrun_change_id = raw.value

  # If it's already a string
  } else if type(raw) is "string" {
    tfrun_change_id = raw
  }
}

print("CHANGE_ID runtime value:", tfrun_change_id)

change_id_runtime_valid = tfrun_change_id is not ""

# -------------------------
# Google provider check
# -------------------------
google_provider_has_request_reason = false

if "google" in tfconfig.providers {

  for tfconfig.providers.google as p {

    has_rr = "request_reason" in p.config

    print("google provider request_reason present:", has_rr)

    if has_rr {

      rr_val = p.config.request_reason
      print("request_reason value:", rr_val)

      if rr_val is not "" {
        google_provider_has_request_reason = true
      }
    }
  }
}

# -------------------------
# FINAL RULE
# -------------------------
main = rule {
  change_id_exists and change_id_runtime_valid and google_provider_has_request_reason
}
