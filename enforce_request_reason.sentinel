import "tfconfig/v2" as tfconfig
import "tfrun"

print("---- Sentinel Debug Output ----")

# -------------------------
# CHANGE_ID existence (config)
# -------------------------
change_id_exists = false
if "CHANGE_ID" in tfconfig.variables {
  change_id_exists = true
}

print("CHANGE_ID exists in config:", change_id_exists)

# -------------------------
# Runtime value (ONLY value, no default)
# -------------------------
tfrun_change_id = ""

if "CHANGE_ID" in tfrun.variables {
  if "value" in tfrun.variables["CHANGE_ID"] {
    tfrun_change_id = tfrun.variables["CHANGE_ID"].value
  }
}

print("CHANGE_ID runtime value:", tfrun_change_id)

change_id_runtime_valid = false
if tfrun_change_id is not "" {
  change_id_runtime_valid = true
}

# -------------------------
# Google provider check
# -------------------------
google_provider_has_request_reason = false

if "google" in tfconfig.providers {

  for tfconfig.providers.google as p {

    has_rr = false
    if "request_reason" in p.config {
      has_rr = true
    }

    print("google provider request_reason present:", has_rr)

    if has_rr {
      rr_val = p.config.request_reason
      print("request_reason value:", rr_val)

      if rr_val is not "" {
        google_provider_has_request_reason = true
      }
    }
  }
}

# -------------------------
# FINAL RULE (NO MULTILINE EXPRESSIONS)
# -------------------------
main = rule {
  change_id_exists
  and change_id_runtime_valid
  and google_provider_has_request_reason
}
