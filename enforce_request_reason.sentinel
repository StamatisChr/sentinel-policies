import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Capture CHANGE_ID
change_id = tfplan.variables.CHANGE_ID.value else ""

# 2. Validation Rule
# We use 'is' for all comparisons because it handles 'undefined' safely
request_reason_exists = rule {
    any tfrun.variables as _, v {
        (v.category else "") is "env" and 
        (v.key else "") is "CLOUDSDK_CORE_REQUEST_REASON"
    }
}

change_id_is_valid = rule {
    change_id is not ""
}

# 3. Main Rule
# 'is true' ensures a boolean result and prevents 'undefined' errors
main = rule {
    (change_id_is_valid and request_reason_exists) is true
}

# 4. English status prints
print("Requirement 1: CHANGE_ID exists and is not empty...")
print("Result: " + string(change_id_is_valid))

print("Requirement 2: Env var 'CLOUDSDK_CORE_REQUEST_REASON' exists...")
print("Result: " + string(request_reason_exists))
