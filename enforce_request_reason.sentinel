import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Prepare the values
change_id = tfplan.variables.CHANGE_ID.value else ""
run_id = tfrun.id

# This is exactly what TFE holds in the environment variable
expected_literal = "${TFE_RUN_ID} ${CHANGE_ID}"
expected_resolved = run_id + " " + change_id

# 2. Check CHANGE_ID
change_id_is_valid = rule {
    change_id is not ""
}

# 3. Check Environment Variable by Value
# Since TFE masks the names (keys), we check if the VALUE exists in the env
# This is the only way to find it when other sensitive vars are present
request_reason_exists = rule {
    any tfrun.variables as _, v {
        (v.category else "") is "env" and 
        (v.value is expected_literal or v.value is expected_resolved)
    }
}

# 4. Main Rule
main = rule {
    (change_id_is_valid and request_reason_exists) is true
}

print("CHANGE_ID valid: " + string(change_id_is_valid))
print("Request Reason found: " + string(request_reason_exists))
