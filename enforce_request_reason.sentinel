import "tfrun" as tfrun
import "tfplan/v2" as tfplan
import "strings"

# 1. Get the change_id from the plan variables
change_id = tfplan.variables.change_id.value else ""

# 2. Construct the exact expected string
expected_reason = tfrun.id + " " + change_id

# 3. Validation Logic
validate_env_config = func() {
    # Check if change_id is valid
    if change_id == "" or change_id == "blabla" {
        print("FOUT: change_id is missing, empty, or still set to 'blabla'. Please update the workspace variable.")
        return false
    }

    found_correct_env = false
    
    for tfrun.variables as _, v {
        if v.category == "env" and v.key == "CLOUDSDK_CORE_REQUEST_REASON" {
            if v.value == expected_reason {
                found_correct_env = true
            } else {
                print("FOUT: Value mismatch.")
                print("Expected: '" + expected_reason + "'")
                print("Actual:   '" + v.value + "'")
            }
        }
    }

    if not found_correct_env {
        print("FOUT: Environment variable 'CLOUDSDK_CORE_REQUEST_REASON' is missing or formatted incorrectly.")
        return false
    }

    return true
}

main = rule {
    validate_env_config()
}
