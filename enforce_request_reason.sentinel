import "tfplan/v2" as tfplan

# 1. Validation Logic
validate_configuration = func() {
    print("DEBUG: Starting Policy Validation...")
    
    # Check CHANGE_ID
    change_id = tfplan.variables.CHANGE_ID.value else "MISSING_IN_WORKSPACE"
    print("DEBUG: CHANGE_ID value found: '" + change_id + "'")
    
    if change_id == "MISSING_IN_WORKSPACE" or change_id == "" {
        print("FOUT: CHANGE_ID must be set in the workspace.")
        return false
    }

    # Expected HCL string
    expected_value = "${TFE_RUN_ID} ${var.CHANGE_ID}"
    print("DEBUG: Looking for literal HCL string: '" + expected_value + "'")
    
    # Safely get providers
    providers = tfplan.configuration.providers else {}
    print("DEBUG: Number of provider blocks detected: " + string(length(providers)))
    
    found_google = false
    all_google_providers_valid = true

    # 2. Iterate and Debug
    for providers as p_address, p {
        print("DEBUG: Processing provider at address: " + p_address)
        print("DEBUG: Provider Name: " + (p.name else "unknown"))

        if p.name == "google" or p.name == "google-beta" {
            found_google = true
            print("DEBUG: Google provider identified. Checking attributes...")
            
            # Check for request_reason
            if (p.expressions.request_reason) is defined {
                # In configuration, strings are usually in constant_value
                actual_value = p.expressions.request_reason.constant_value else "NOT_A_CONSTANT"
                print("DEBUG: Found 'request_reason'. Value: '" + actual_value + "'")
                
                if actual_value == expected_value {
                    print("DEBUG: Match successful for " + p_address)
                } else {
                    print("FOUT: Mismatch in " + p_address)
                    print("  Expected: " + expected_value)
                    print("  Actual:   " + actual_value)
                    all_google_providers_valid = false
                }
            } else {
                print("FOUT: 'request_reason' attribute is MISSING from provider: " + p_address)
                all_google_providers_valid = false
            }
        }
    }

    # 3. Final Evaluation
    if not found_google {
        print("FOUT: No 'google' or 'google-beta' provider blocks found in your HCL.")
        return false
    }

    return all_google_providers_valid
}

# Main Rule
main = rule {
    validate_configuration()
}
