import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Setup
change_id = tfplan.variables["CHANGE_ID"].value else "MISSING"
run_id    = tfrun.id
expected  = run_id + " " + change_id

print("DEBUG: Target Value: '" + expected + "'")

# 2. Direct Value Validation
validate_env = func() {
    
    # We use a boolean flag to track if we find a match anywhere
    matched = false

    # We iterate through all variables. 
    # To avoid the 'undefined' error, we use 'else' on every property access.
    for tfrun.variables as _, v {
        val = v.value else "HIDDEN_OR_UNDEFINED"
        cat = v.category else "unknown"
        
        # If we find our expected string in an environment variable, we succeed
        if cat == "env" and val == expected {
            matched = true
            break
        }
    }

    if matched {
        print("SUCCES: Match gevonden voor '" + expected + "'")
        return true
    } else {
        print("FOUT: Geen enkele omgevingsvariabele komt overeen met de verwachte waarde.")
        print("Tip: Zorg dat CLOUDSDK_CORE_REQUEST_REASON exact '" + expected + "' is.")
        return false
    }
}

main = rule {
    validate_env()
}
