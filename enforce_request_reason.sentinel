import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Capture inputs
print("Checking Workspace Variables...")
change_id = tfplan.variables["CHANGE_ID"].value else "MISSING"
run_id    = tfrun.id

expected_resolved = run_id + " " + change_id
expected_literal  = "${TFE_RUN_ID} ${CHANGE_ID}"

print("Target Value 1: '" + expected_resolved + "'")
print("Target Value 2: '" + expected_literal + "'")

# 2. Validation Rule
# We look for ANY environment variable that has our expected value.
# We skip the 'key' check because TFE might be masking it as 'unknown'.
request_reason_is_valid = rule {
    any tfrun.variables as _, v {
        (v.category else "") == "env" and
        (v.value == expected_resolved or v.value == expected_literal)
    }
}

main = rule {
    request_reason_is_valid
}

print("Policy validation complete.")
