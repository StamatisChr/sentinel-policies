import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Capture and print the inputs
print("STAP 1: Ophalen van variabelen...")

# Safe check for CHANGE_ID
change_id = tfplan.variables["CHANGE_ID"].value else "UNDEFINED_IN_PLAN"
print("DEBUG: CHANGE_ID uit tfplan is: '" + change_id + "'")

# Capture TFE Run ID
run_id = tfrun.id
print("DEBUG: TFE_RUN_ID uit tfrun is: '" + run_id + "'")

# Construct expected string
expected_value = run_id + " " + change_id
print("DEBUG: Verwachte waarde voor request_reason: '" + expected_value + "'")

# 2. Validation Function
validate_config = func() {
    print("STAP 2: Controleren van CHANGE_ID waarde...")
    if change_id == "UNDEFINED_IN_PLAN" or change_id == "" or change_id == "blabla" {
        print("FOUT: CHANGE_ID is niet correct (leeg of standaardwaarde).")
        return false
    }
    print("CHECK: CHANGE_ID is valide.")

    print("STAP 3: Doorlopen van omgevingsvariabelen...")
    found_var = false
    
    for tfrun.variables as k, v {
        # Using 'else' to avoid the 'undefined' error during comparison
        current_key = v.key else "unknown"
        current_cat = v.category else "unknown"
        current_val = v.value else "unknown"

        # Log every environment variable found (optional, helps find typos)
        if current_cat == "env" {
            print("  - Gevonden env var: " + current_key + " = " + current_val)
        }

        if current_cat == "env" and current_key == "CLOUDSDK_CORE_REQUEST_REASON" {
            found_var = true
            print("STAP 4: Vergelijken van CLOUDSDK_CORE_REQUEST_REASON...")
            
            if current_val == expected_value {
                print("SUCCES: Waarde komt exact overeen!")
                return true
            } else {
                print("FOUT: Waarde komt NIET overeen.")
                print("  Verwacht: '" + expected_value + "'")
                print("  Gekregen: '" + current_val + "'")
                return false
            }
        }
    }

    if not found_var {
        print("FOUT: De variabele 'CLOUDSDK_CORE_REQUEST_REASON' is helemaal niet gevonden.")
        return false
    }
    
    return false
}

# Main enforcement
main = rule {
    validate_config()
}
