import "tfconfig/v2" as tfconfig
import "tfrun"

# --- Fetch values safely ---
change_id_var        = tfconfig.variables["CHANGE_ID"] else null
google_providers     = tfconfig.providers.google else []
tfrun_change_id      = tfrun.variables["CHANGE_ID"] else ""

# --- Debug prints ---
print("---- Sentinel Debug Output ----")

print("CHANGE_ID variable defined in config:", change_id_var is not null)

if change_id_var is not null {
  has_default = "default" in change_id_var
  default_val = has_default ? change_id_var.default : "NO DEFAULT"

  print("CHANGE_ID has default:", has_default)
  print("CHANGE_ID default value:", default_val)
}

print("CHANGE_ID runtime value (tfrun):", tfrun_change_id)

# --- Provider inspection ---
provider_has_request_reason = false

for google_providers as p {
  has_rr = "request_reason" in p.config
  rr_val = has_rr ? p.config.request_reason : "NOT SET"

  print("Found google provider block")
  print("  request_reason present:", has_rr)
  print("  request_reason value:", rr_val)

  if has_rr {
    provider_has_request_reason = true
  }
}

# --- Rules ---
change_id_exists = rule {
  change_id_var is not null
}

change_id_not_empty_config = rule {
  change_id_exists and (
    not ("default" in change_id_var) or
    change_id_var.default is not ""
  )
}

change_id_not_empty_runtime = rule {
  tfrun_change_id is not ""
}

google_provider_has_request_reason = rule {
  provider_has_request_reason
}

# --- Final decision with explanation ---
main = rule {
  print("---- Evaluation Results ----")
  print("change_id_exists:", change_id_exists)
  print("change_id_not_empty_config:", change_id_not_empty_config)
  print("change_id_not_empty_runtime:", change_id_not_empty_runtime)
  print("google_provider_has_request_reason:", google_provider_has_request_reason)

  change_id_exists and
  change_id_not_empty_config and
  change_id_not_empty_runtime and
  google_provider_has_request_reason
}
