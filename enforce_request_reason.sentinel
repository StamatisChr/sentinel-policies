import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Check Terraform Variable: CHANGE_ID
# We check if it exists in the plan and is not an empty string
change_id_is_valid = rule {
    (tfplan.variables.CHANGE_ID.value else "") is not ""
}

# 2. Check Environment Variable: CLOUDSDK_CORE_REQUEST_REASON
# We check if ANY variable has the correct name, regardless of value
request_reason_exists = rule {
    any tfrun.variables as _, v {
        (v.key else "") is "CLOUDSDK_CORE_REQUEST_REASON" and
        (v.category else "") is "env"
    }
}

# 3. Main Rule
# Both must be true. We use 'is true' to force a boolean result.
main = rule {
    (change_id_is_valid and request_reason_exists) is true
}

# 4. Debug Prints
print("Checking CHANGE_ID...")
print("CHANGE_ID Status: " + string(change_id_is_valid))

print("Checking CLOUDSDK_CORE_REQUEST_REASON...")
print("Env Var Status: " + string(request_reason_exists))
