import "tfplan/v2" as tfplan

# 1. Helper function to scan modules recursively for the google provider
find_google_providers = func(module) {
    found_providers = []
    
    # Check providers in the current module
    for module.providers as _, p {
        if p.name == "google" or p.name == "google-beta" {
            append(found_providers, p)
        }
    }
    
    # Check sub-modules recursively
    for module.module_calls as _, mc {
        found_providers = found_providers + find_google_providers(mc.module)
    }
    
    return found_providers
}

# 2. Validation Logic
validate_config = func() {
    print("DEBUG: Starting Universal Search for Google Providers...")
    
    # Get CHANGE_ID for validation
    change_id = tfplan.variables.CHANGE_ID.value else ""
    if change_id == "" {
        print("FOUT: CHANGE_ID variable is missing or empty.")
        return false
    }

    # Locate all providers across the whole tree
    all_providers = find_google_providers(tfplan.configuration.root_module)
    print("DEBUG: Total Google providers found: " + string(length(all_providers)))

    if length(all_providers) == 0 {
        print("FOUT: No Google provider blocks found in root or modules.")
        return false
    }

    all_valid = true

    for all_providers as p {
        print("DEBUG: Checking provider: " + p.name)
        
        # Check if request_reason exists
        if (p.expressions.request_reason) is defined {
            # Instead of a literal check, we check the 'references' 
            # This proves the code is using the variables, regardless of strings
            refs = p.expressions.request_reason.references else []
            print("DEBUG: References found in request_reason: " + string(refs))
            
            has_run_id = false
            has_change_id = false
            
            for refs as r {
                if r contains "var.TFE_RUN_ID" { has_run_id = true }
                if r contains "var.CHANGE_ID"   { has_change_id = true }
            }

            if has_run_id and has_change_id {
                print("SUCCES: request_reason is correctly linked to variables.")
            } else {
                print("FOUT: request_reason is missing required variable references.")
                print("Required: var.TFE_RUN_ID AND var.CHANGE_ID")
                all_valid = false
            }
        } else {
            print("FOUT: 'request_reason' is NOT defined in this provider block.")
            all_valid = false
        }
    }

    return all_valid
}

# 3. Main Rule
main = rule {
    validate_config()
}
