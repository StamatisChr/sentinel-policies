import "tfrun" as tfrun
import "tfplan/v2" as tfplan
import "strings"

# 1. Get the CHANGE_ID from the plan variables
change_id = tfplan.variables.CHANGE_ID.value else ""

# 2. Construct the exact expected string
expected_reason = tfrun.id + " " + change_id

# 3. Validation Logic
validate_env_config = func() {
    # Ensure CHANGE_ID isn't the default or empty
    if change_id == "" or change_id == "blabla" {
        print("FOUT: De CHANGE_ID variabele is niet correct ingesteld.")
        return false
    }

    found_correct_env = false
    
    for tfrun.variables as _, v {
        if v.category == "env" and v.key == "CLOUDSDK_CORE_REQUEST_REASON" {
            if v.value == expected_reason {
                found_correct_env = true
            } else {
                print("FOUT: CLOUDSDK_CORE_REQUEST_REASON mismatch.")
                print("Verwacht: '" + expected_reason + "'")
                print("Gekregen: '" + v.value + "'")
            }
        }
    }

    if not found_correct_env {
        print("FOUT: De omgevingsvariabele CLOUDSDK_CORE_REQUEST_REASON ontbreekt of is onjuist.")
        return false
    }

    return true
}

# Main enforcement
main = rule {
    validate_env_config()
}
