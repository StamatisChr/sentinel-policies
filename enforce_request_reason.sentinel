import "tfrun" as tfrun
import "tfplan/v2" as tfplan

# 1. Capture the CHANGE_ID from the plan
change_id = tfplan.variables.CHANGE_ID.value else "MISSING"

# 2. Capture the current Run ID
run_id = tfrun.id

# 3. Construct the expected string
expected_value = run_id + " " + change_id

# 4. Validation Function
validate_setup = func() {
    
    # Check if CHANGE_ID is valid
    if change_id == "MISSING" or change_id == "blabla" {
        print("FOUT: CHANGE_ID variable is missing or set to default 'blabla'.")
        return false
    }

    # Check for the Environment Variable
    for tfrun.variables as _, v {
        if v.category == "env" and v.key == "CLOUDSDK_CORE_REQUEST_REASON" {
            if v.value == expected_value {
                return true
            } else {
                print("FOUT: CLOUDSDK_CORE_REQUEST_REASON is incorrect.")
                print("Verwacht: " + expected_value)
                print("Gekregen: " + v.value)
                return false
            }
        }
    }

    print("FOUT: Environment variable 'CLOUDSDK_CORE_REQUEST_REASON' not found.")
    return false
}

# Main enforcement
main = rule {
    validate_setup()
}
